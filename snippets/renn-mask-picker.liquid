{%- comment -%}
  Pick-three mask picker: the customer taps three of the four masks.
  It maps the choice onto the product's variant (variants are named like "Mud, Collagen, PDRN").
  Params: product, uid
{%- endcomment -%}
{%- assign mp_v = product.selected_or_first_available_variant -%}
{%- assign mp_keys = 'Mud|Collagen|PDRN|Kojic' | split: '|' -%}
{%- assign mp_files = 'mud|collagen|pdrn|kojic' | split: '|' -%}
{%- assign mp_handles = 'zero-pore-blackhead-mud-mask|collagen-night-wrapping-mask|pdrn-pink-caffeine-night-wrapping-mask|kojic-acid-turmeric-night-wrapping-mask' | split: '|' -%}
{%- assign mp_names = 'Zero Pore Mud|Collagen Night|PDRN Pink Caffeine|Kojic Turmeric' | split: '|' -%}
{%- assign mp_on = mp_v.title | split: ', ' -%}
<fieldset class="mpick" data-mpick>
  <legend class="mono"><span>Choose your 3 masks</span> <b data-mcount>3 of 3 chosen</b></legend>
  <div class="mgrid">
    {%- for k in mp_keys -%}
      {%- assign mp_p = all_products[mp_handles[forloop.index0]] -%}
      {%- if mp_p.featured_image -%}{%- assign src = mp_p.featured_image | image_url: width: 300 -%}{%- else -%}{%- assign src = mp_files[forloop.index0] | append: '.jpg' | asset_url -%}{%- endif -%}
      <label class="mopt">
        <input type="checkbox" value="{{ k }}"{% if mp_on contains k %} checked{% endif %}>
        <span class="mimg"><img src="{{ src }}" alt="" loading="lazy" width="150" height="150"><i aria-hidden="true"></i></span>
        <span class="mname">{{ mp_names[forloop.index0] }}</span>
      </label>
    {%- endfor -%}
  </div>
  <input type="hidden" name="id" value="{{ mp_v.id }}">
  <script type="application/json">[{%- for x in product.variants -%}{"id":{{ x.id }},"t":{{ x.title | json }},"a":{{ x.available | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]</script>
</fieldset>
