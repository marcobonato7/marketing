{%- comment -%} Email signup. Uses Shopify's own newsletter form: signups appear in Customers, tagged "newsletter", with email marketing consent. {%- endcomment -%}
<section class="blk signup reveal" id="signup" style="--c:var(--pearl)">
  <svg class="drip" viewBox="0 0 24 90" aria-hidden="true"><path d="M12 0v70"/><circle cx="12" cy="80" r="6"/></svg>
  <div class="wrap">
    <span class="kicker mono rise">{{ section.settings.kicker }}</span>
    <h2 class="big rise center">{{ section.settings.heading }}</h2>
    <p class="lede rise center">{{ section.settings.text }}</p>
    {%- form 'customer', id: 'renn-signup', class: 'rise' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="renn-email" class="vh">Email address</label>
      <input id="renn-email" name="contact[email]" type="email" autocomplete="email" placeholder="Your email" required>
      <button class="btn" type="submit">Sign me up</button>
      {%- if form.posted_successfully? -%}
        <p class="msg" role="status">You're on the list. Watch your inbox.</p>
      {%- elsif form.errors -%}
        <p class="msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Email signup",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "First to know" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New drops and restocks, straight to you." },
    { "type": "text", "id": "text", "label": "Text", "default": "Launches, restocks and the odd discount. No spam, unsubscribe any time." }
  ],
  "presets": [ { "name": "Email signup" } ]
}
{% endschema %}
