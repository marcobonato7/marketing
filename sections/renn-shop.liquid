{%- liquid
  assign list = section.settings.products
  if list == blank or list.size == 0
    assign list = collections.all.products
  endif
-%}
<section class="blk reveal" id="shop" style="--c:var(--clay)">
  <div class="wrap">
    <span class="kicker mono rise">{{ section.settings.kicker }}</span>
    <h2 class="big rise">{{ section.settings.heading }}</h2>
    <p class="lede rise">{{ section.settings.text }}</p>
    <div class="grid">
      {%- for p in list limit: 9 -%}
        {%- if settings.bundle_product != blank and p.id == settings.bundle_product.id -%}{%- continue -%}{%- endif -%}
        <article class="scard rise" id="shop-{{ p.handle }}" style="transition-delay:{{ forloop.index0 | times: 90 }}ms">
          <a href="{{ p.url }}" class="tlink" aria-label="{{ p.title | escape }}">{% render 'renn-tile', product: p %}</a>
          <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
          <p>{{ p.description | strip_html | truncatewords: 22 }}</p>
          <div class="buy">{% render 'renn-buy', product: p, label: 'Shop Now' %}</div>
        </article>
      {%- else -%}
        {%- if request.design_mode -%}<p class="muted">Add products in Shopify, then pick them here in the theme editor.</p>{%- endif -%}
      {%- endfor -%}
      {%- if section.settings.show_bundle -%}{% render 'renn-bundle-card' %}{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "The edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick the mask that fits tonight." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Genuine medicube skincare: a $35 neck cream with a built-in gua sha, plus four masks at $25 each. One clears pores in minutes. Three work while you sleep." },
    { "type": "checkbox", "id": "show_bundle", "label": "Show the bundle after the products", "default": true },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8, "info": "Leave empty to show all products." }
  ],
  "presets": [ { "name": "Shop grid" } ]
}
{% endschema %}
