{%- liquid
  assign list = section.settings.products
  if list == blank or list.size == 0
    assign list = collections.all.products
  endif
-%}
<section class="blk reveal" id="shop" style="--c:var(--clay)">
  <div class="wrap">
    <span class="kicker mono rise">{{ section.settings.kicker }}</span>
    <h2 class="big rise">{{ section.settings.heading }}</h2>
    <p class="lede rise">{{ section.settings.text }}</p>
    <div class="grid">
      {%- for p in list limit: 9 -%}
        {%- if settings.bundle_product != blank and p.id == settings.bundle_product.id -%}{%- continue -%}{%- endif -%}
        {%- if settings.set_product != blank and p.id == settings.set_product.id -%}{%- continue -%}{%- endif -%}
        <article class="scard rise" id="shop-{{ p.handle }}" style="transition-delay:{{ forloop.index0 | times: 90 }}ms">
          <a href="{{ p.url }}" class="tlink" aria-label="{{ p.title | escape }}">{% render 'renn-tile', product: p %}</a>
          <h3><a href="{{ p.url }}">{{ p.title }}</a></h3>
          <p>{{ p.description | strip_html | truncatewords: 22 }}</p>
          <div class="buy">{% render 'renn-buy', product: p, label: 'Shop Now' %}</div>
        </article>
      {%- else -%}
        {%- assign fb_names = 'PDRN Collagen Gua Sha Neck Wrinkle Cream|Zero Pore Blackhead Mud Mask|Collagen Night Wrapping Mask|PDRN Pink Caffeine Night Wrapping Mask|Kojic Acid Turmeric Night Wrapping Mask' | split: '|' -%}
        {%- assign fb_lines = 'PDRN, collagen and 5% Volufiline, with a built-in gua sha head that massages as you apply.|A 30% clay wash-off mask with AHA, BHA and PHA. Clears pores in three minutes.|An overnight wrapping mask that seals in moisture. Wake up smooth.|PDRN and caffeine for a rested, calm-looking face by morning.|Kojic acid and turmeric for a brighter, more even tone.' | split: '|' -%}
        {%- assign fb_imgs = 'neck|mud|collagen|pdrn|kojic' | split: '|' -%}
        {%- assign fb_prices = '$42.50|$32.50|$32.50|$32.50|$32.50' | split: '|' -%}
        {%- for n in fb_names -%}
          <article class="scard rise" style="transition-delay:{{ forloop.index0 | times: 90 }}ms">
            <a href="#pour-{{ forloop.index }}" class="tlink" aria-label="{{ n | escape }}">{% render 'renn-tile', fallback: fb_imgs[forloop.index0], fallback_title: n %}</a>
            <h3><a href="#pour-{{ forloop.index }}">{{ n }}</a></h3>
            <p>{{ fb_lines[forloop.index0] }}</p>
            <div class="buy">{% render 'renn-buy', label: 'Shop Now', fallback_price: fb_prices[forloop.index0] %}</div>
          </article>
        {%- endfor -%}
        {%- if request.design_mode -%}<p class="muted">These cards show until your products are created in Shopify.</p>{%- endif -%}
      {%- endfor -%}
      {%- capture season -%}{% render 'renn-promo-season' %}{%- endcapture -%}
      {%- assign season = season | strip -%}
      {%- if section.settings.show_bundle -%}<div class="bcard-wrap" data-season-off{% if season != blank %} hidden{% endif %}>{% render 'renn-bundle-card' %}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "The edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick what your skin needs." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Genuine medicube skincare: a $42.50 neck cream with a built-in gua sha, plus four masks at $32.50 each. One clears pores in minutes. Three work while you sleep." },
    { "type": "checkbox", "id": "show_bundle", "label": "Show the bundle after the products", "default": true },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 8, "info": "Leave empty to show all products." }
  ],
  "presets": [ { "name": "Shop grid" } ]
}
{% endschema %}
