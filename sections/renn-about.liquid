<section class="blk about reveal" id="about">
  <div class="wrap">
    <div class="img rise">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1400', sizes: '(max-width: 900px) 100vw, 50vw' }}
      {%- else -%}
        <img src="{{ 'frame-1.jpg' | asset_url }}" alt="The pink medicube neck cream with its gua sha head" loading="lazy" width="1600" height="905">
      {%- endif -%}
    </div>
    <div>
      <span class="kicker mono rise">{{ section.settings.kicker }}</span>
      <h2 class="big rise">{{ section.settings.heading }}</h2>
      <p class="lede rise" style="margin-bottom:0">{{ section.settings.text }}</p>
      <ul class="promises rise">
        {%- if section.settings.p1 != blank -%}<li>{{ section.settings.p1 }}</li>{%- endif -%}
        {%- if section.settings.p2 != blank -%}<li>{{ section.settings.p2 }}</li>{%- endif -%}
        <li>Real answers from real people at <a href="mailto:{{ settings.contact_email | default: 'info@rennskin.store' }}">{{ settings.contact_email | default: 'info@rennskin.store' }}</a>.</li>
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "kicker", "label": "Small label", "default": "About Renn" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A small shop for a short routine." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Renn is an independent shop. We chose a medicube neck cream and four masks that cover what most of us need: a smoother-looking neck, clear pores, moisture, a rested look and a brighter tone. Nothing extra." },
    { "type": "text", "id": "p1", "label": "Promise 1", "default": "Every tube is genuine medicube, in its original box." },
    { "type": "text", "id": "p2", "label": "Promise 2", "default": "Simple prices: masks from $22.50, $42 for the neck cream." }
  ],
  "presets": [ { "name": "About" } ]
}
{% endschema %}
