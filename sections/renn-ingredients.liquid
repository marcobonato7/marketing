<section class="blk reveal" id="inside" style="--c:var(--pearl)">
  <div class="wrap">
    <span class="kicker mono rise">{{ section.settings.kicker }}</span>
    <h2 class="big rise">{{ section.settings.heading }}</h2>
    <p class="lede rise">{{ section.settings.text }}</p>
    <div class="ings rise">
      {%- for block in section.blocks -%}
        <div class="ing" {{ block.shopify_attributes }}>
          <div class="dot">
            {%- if block.settings.mud -%}<i style="background:var(--clay)" title="Mud mask"></i>{%- endif -%}
            {%- if block.settings.collagen -%}<i style="background:var(--glass)" title="Collagen"></i>{%- endif -%}
            {%- if block.settings.pdrn -%}<i style="background:var(--pearl)" title="PDRN"></i>{%- endif -%}
            {%- if block.settings.kojic -%}<i style="background:var(--honey)" title="Kojic"></i>{%- endif -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.note != blank -%}<p class="note rise">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "What's inside",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "What's inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ten ingredients, in plain words." },
    { "type": "text", "id": "text", "label": "Text", "default": "The dots show which mask each one is in." },
    { "type": "textarea", "id": "note", "label": "Note", "default": "The kojic mask contains retinol, so wear sunscreen the next day. New to a mask? Try it on a small patch of skin first." }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingredient", "settings": [
      { "type": "text", "id": "title", "label": "Name", "default": "Ingredient" },
      { "type": "textarea", "id": "text", "label": "What it does" },
      { "type": "checkbox", "id": "mud", "label": "In the mud mask", "default": false },
      { "type": "checkbox", "id": "collagen", "label": "In the collagen mask", "default": false },
      { "type": "checkbox", "id": "pdrn", "label": "In the PDRN mask", "default": false },
      { "type": "checkbox", "id": "kojic", "label": "In the kojic mask", "default": false } ] }
  ],
  "presets": [ { "name": "What's inside" } ]
}
{% endschema %}
