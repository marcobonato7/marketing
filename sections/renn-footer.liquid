<footer class="ftr">
  <div class="wrap">
    <div>
      <a class="logo" href="{{ routes.root_url }}">{{ settings.wordmark | default: 'renn' }}<b>.</b></a>
      <p class="tag">{{ section.settings.tagline }}</p>
    </div>
{%- assign ig = settings.instagram | default: 'https://www.instagram.com/rennskincare/' -%}
    <div>
      <h4>Follow</h4>
      <ul>
        <li><a href="{{ ig }}" target="_blank" rel="noopener">Instagram @rennskincare</a></li>
        {%- if settings.tiktok != blank -%}<li><a href="{{ settings.tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
      </ul>
    </div>
    <div>
      <h4>Help</h4>
      <ul>
        <li><a href="/pages/shipping">Shipping</a></li>
        {%- if shop.refund_policy -%}<li><a href="{{ shop.refund_policy.url }}">Returns</a></li>{%- endif -%}
        {%- if shop.privacy_policy -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy</a></li>{%- endif -%}
        {%- if shop.terms_of_service -%}<li><a href="{{ shop.terms_of_service.url }}">Terms</a></li>{%- endif -%}
        <li><a href="/pages/contact">Contact</a></li>
        <li><a href="mailto:{{ settings.contact_email | default: 'info@rennskin.store' }}">{{ settings.contact_email | default: 'info@rennskin.store' }}</a></li>
        <li><a href="{{ routes.root_url }}#faq">Questions</a></li>
      </ul>
    </div>
  </div>
  <div class="legal">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: shop.name }}</span>
    <span>{{ section.settings.disclaimer }}</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Less effort. More glow." },
    { "type": "textarea", "id": "disclaimer", "label": "Retailer note", "default": "Renn is an independent retailer of genuine medicube products and is not affiliated with or endorsed by medicube or APR Corp." }
  ]
}
{% endschema %}
