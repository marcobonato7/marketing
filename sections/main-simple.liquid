{%- comment -%} One section for the simpler pages: page, 404, search, collections list, blog, article, password. {%- endcomment -%}
<section class="page">
  <div class="wrap narrow">
    {%- case request.page_type -%}
      {%- when 'page' -%}
        <h1 class="big">{{ page.title }}</h1>
        <div class="rte">{{ page.content }}</div>
        {%- if page.handle == 'contact' -%}
          {%- form 'contact', class: 'cform' -%}
            {%- if form.posted_successfully? -%}
              <p class="cform-ok">Thanks. Your message is on its way, and we'll reply by email.</p>
            {%- else -%}
              {%- if form.errors -%}<p class="cform-err">{{ form.errors | default_errors }}</p>{%- endif -%}
              <p class="lede">Questions about an order or a product? Send us a note and a real person will reply.</p>
              <ul class="cinfo">
                <li><span class="mono">Email</span><a href="mailto:{{ settings.contact_email | default: 'info@rennskin.store' }}">{{ settings.contact_email | default: 'info@rennskin.store' }}</a></li>
                <li><span class="mono">Tracking</span>Sent by email within 2 business days of your order</li>
                <li><span class="mono">Orders</span>Please include your order number</li>
              </ul>
              <label for="c-name">Name</label>
              <input id="c-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
              <label for="c-email">Email</label>
              <input id="c-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
              <label for="c-msg">Message</label>
              <textarea id="c-msg" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
              <button class="btn" type="submit">Send message</button>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

      {%- when '404' -%}
        <span class="kicker mono">404</span>
        <h1 class="big">This page slipped away.</h1>
        <p class="lede">It may have moved. Everything else is right where you left it.</p>
        <a class="btn" href="{{ routes.root_url }}#shop">Back to the shop</a>

      {%- when 'search' -%}
        <h1 class="big">Search</h1>
        <form action="{{ routes.search_url }}" method="get" class="searchform" role="search">
          <label class="vh" for="q">Search</label>
          <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products">
          <button class="btn" type="submit">Search</button>
        </form>
        {%- if search.performed -%}
          <p class="muted">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p>
          <div class="grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <article class="scard">
                  <a href="{{ item.url }}" class="tlink">{% render 'renn-tile', product: item %}</a>
                  <h3><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <div class="buy">{% render 'renn-buy', product: item, label: 'Add to Cart' %}</div>
                </article>
              {%- else -%}
                <article class="scard"><h3><a href="{{ item.url }}">{{ item.title }}</a></h3></article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      {%- when 'list-collections' -%}
        <h1 class="big">Collections</h1>
        <ul class="plain">
          {%- for c in collections -%}<li><a href="{{ c.url }}">{{ c.title }}</a></li>{%- endfor -%}
        </ul>

      {%- when 'blog' -%}
        <h1 class="big">{{ blog.title }}</h1>
        {%- paginate blog.articles by 12 -%}
          <ul class="plain">
            {%- for a in blog.articles -%}<li><a href="{{ a.url }}">{{ a.title }}</a> <span class="muted small">{{ a.published_at | date: '%B %-d, %Y' }}</span></li>{%- endfor -%}
          </ul>
          {%- if paginate.pages > 1 -%}<nav class="pager">{{ paginate | default_pagination }}</nav>{%- endif -%}
        {%- endpaginate -%}

      {%- when 'article' -%}
        <span class="kicker mono">{{ article.published_at | date: '%B %-d, %Y' }}</span>
        <h1 class="big">{{ article.title }}</h1>
        <div class="rte">{{ article.content }}</div>

      {%- when 'password' -%}
        <p class="logo xl">{{ settings.wordmark | default: 'renn' }}<b>.</b></p>
        <p class="lede">{{ shop.password_message | default: 'Opening soon.' }}</p>
        {%- form 'storefront_password', class: 'searchform' -%}
          <label class="vh" for="pw">Password</label>
          <input id="pw" type="password" name="password" placeholder="Store password">
          <button class="btn" type="submit">Enter</button>
          {%- if form.errors -%}<p class="msg">That password didn't work.</p>{%- endif -%}
        {%- endform -%}
    {%- endcase -%}
  </div>
</section>

{% schema %}
{ "name": "Page content", "settings": [] }
{% endschema %}
