<!doctype html>
{%- capture season -%}{% render 'renn-promo-season' %}{%- endcapture -%}
<html lang="{{ request.locale.iso_code }}"{% if season != blank %} class="has-bar"{% endif %}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#F5EEE6">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% if current_tags %} | {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} | Page {{ current_page }}{% endif %}{%- assign bn = settings.brand_name | default: shop.name -%}{% unless page_title contains bn %} | {{ bn }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23F5EEE6'/%3E%3Ctext x='12' y='44' font-family='Helvetica,Arial' font-size='34' fill='%232A2421'%3Er%3C/text%3E%3Ccircle cx='44' cy='40' r='5' fill='%23F2A7C3'/%3E%3C/svg%3E">
  {{ 'renn-bricolage.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'renn-hanken.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {%- if template.name == 'index' -%}
    {{ 'frame-0.jpg' | asset_url | preload_tag: as: 'image', media: '(min-width: 821px)' }}
    {{ 'm-frame-0.jpg' | asset_url | preload_tag: as: 'image', media: '(max-width: 820px)' }}
  {%- endif -%}
  {{ 'renn.css' | asset_url | stylesheet_tag }}
  <script type="application/ld+json">
    {"@context":"https://schema.org","@type":"Organization","name":{{ settings.brand_name | default: shop.name | json }},"url":{{ shop.url | json }},"description":"Independent online retailer of genuine medicube masks."}
  </script>
  {{ content_for_header }}
</head>
<body class="tpl-{{ template.name }}">
  <a class="skip" href="#main">Skip to content</a>
  {% render 'renn-promo-bar' %}
  {% section 'renn-header' %}
  <main id="main" role="main">
    {{ content_for_layout }}
  </main>
  {% section 'renn-footer' %}
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
    window.RENN_PROMO = { mode: {{ settings.promo_mode | json }}, bf: [{{ settings.bf_start | remove: '-' | plus: 0 }}, {{ settings.bf_end | remove: '-' | plus: 0 }}], xmas: [{{ settings.xmas_start | remove: '-' | plus: 0 }}, {{ settings.xmas_end | remove: '-' | plus: 0 }}] };
    window.RENN_ROUTES = { cartAdd: {{ routes.cart_add_url | append: '.js' | json }}, cart: {{ routes.cart_url | json }}, cartJs: {{ routes.cart_url | append: '.js' | json }} };
  </script>
  <script src="{{ 'renn.js' | asset_url }}" defer></script>
</body>
</html>
